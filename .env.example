# 复制为 .env 并填写实际值（.env 已被 .gitignore 排除，勿提交）
# 1Panel 中可在应用环境变量里逐项配置，效果相同。

# 管理后台 Bearer token（必填，建议强随机值）：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# 新咨询通知 webhook（企业微信群机器人等，可选）
NOTIFY_WEBHOOK_URL=

# Resend 客户自动回复邮件（可选；域名需在 Resend 验证）
RESEND_API_KEY=
RESEND_FROM=no-reply@shenyuanlegal.com

# 重复提交检测窗口（小时）。同一邮箱或电话在窗口内重复提交会返回 409。
DEDUPE_WINDOW_HOURS=24

# 站点公开地址（canonical / OG / sitemap 基准）
SITE_URL=https://shenyuanlegal.com

# --- CRM Agent 参数（可选，均为默认值） ---
# 新线索应在多少小时内联系（逾期提醒用）
CRM_FIRST_SLA_HOURS=24
# 已联系线索应在多少天内推进
CRM_PROGRESS_SLA_DAYS=7
# 后台逾期检查/提醒间隔（小时）
CRM_REMINDER_INTERVAL_HOURS=12

# Google Analytics 4 衡量 ID（G-XXXXXXX，可选；留空则不输出 GA 标签）
# 注意：请把真实 ID 填在 .env（运行时），不要填在这里——本文件是提交到
# 仓库的模板，真实 ID 不应出现在 GitHub。
GA_MEASUREMENT_ID=
