# 复制为 .env 并填写真实值后再部署（1Panel：直接在应用环境变量里填）。
#
# 保护管理后台 /admin 和 GET /admin/intakes.csv 的 Bearer token。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空 = 管理后台与导出接口禁用。
ADMIN_TOKEN=
#
# 新咨询通知 webhook（兼容企业微信群机器人等）。留空 = 不通知。
# 企业微信群机器人：群设置 -> 添加群机器人 -> 复制 Webhook 地址填这里。
NOTIFY_WEBHOOK_URL=
#
# 客户自动回复邮件（SMTP）。留空 = 不发送自动回复。
# 以 QQ 邮箱为例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465 时需 SMTP_USE_TLS=0 并走 SSL，
# 或用 587 + SMTP_USE_TLS=1。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
#
# 重复提交检测窗口（小时）。同一邮箱或电话在窗口内重复提交会返回 409。
DEDUPE_WINDOW_HOURS=24
#
# 站点公开地址（用于 canonical / OG / sitemap 链接）。部署后必须改成真实域名。
SITE_URL=https://your-domain.example.com
